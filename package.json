    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomcatle/dsh-stock-probability-chart.git"
  },
  "homepage": "https://github.com/tomcatle/dsh-stock-probability-chart#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "stock",
    "probability",
    "股票",
    "概率图"
  ],
